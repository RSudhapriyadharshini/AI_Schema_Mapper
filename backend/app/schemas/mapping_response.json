{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mappings",
    "unmapped_fields",
    "ambiguous_fields"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "mappings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      }
    },
    "unmapped_fields": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      }
    },
    "ambiguous_fields": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_field",
        "target_field",
        "target_value",
        "confidence",
        "status",
        "reason",
        "recipe"
      ],
      "properties": {
        "source_field": {
          "type": "string"
        },
        "target_field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "target_value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "null when the source value is used unchanged (only trimmed); otherwise the transformed value"
        },
        "confidence": {
          "type": "number"
        },
        "status": {
          "type": "string",
          "enum": [
            "mapped",
            "unmapped",
            "ambiguous"
          ]
        },
        "reason": {
          "type": "string",
          "description": "one short sentence, at most about 15 words"
        },
        "recipe": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}